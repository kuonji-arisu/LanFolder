<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lanfolder.exe"
        Arguments=""
        InstallLocation="C:\Program Files\LanFolder\LanFolder">
    </Installer>
    <PackageInformation
        PackageName="LanFolder"
        PackageDisplayName="LanFolder"
        PublisherName="CN=LanFolder"
        PublisherDisplayName="LanFolder"
        Version="0.0.3.0"
        PackageDescription="LAN folder sharing desktop app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lanfolder.app"
                Description="LAN folder sharing desktop app"
                DisplayName="LanFolder"
                ExecutableName="lanfolder.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LanFolder</DisplayName>
            <PublisherDisplayName>LanFolder</PublisherDisplayName>
            <Description>LAN folder sharing desktop app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lanfolder.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
